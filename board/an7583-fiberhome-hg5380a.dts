// SPDX-License-Identifier: GPL-2.0-only OR MIT
/*
 * FiberHome HG5380A — Airoha AN7583
 *
 * 由原厂 KernelA 内 DTB（15704 字节，0x3100 处）反编译结果整理，
 * 结构参照 ponwrt 的 an7583-nokia_xg-040g-mf-common.dtsi 与
 * an7581-fiberhome-hg5382a.dts。
 *
 * TODO(上机确认)：
 *   1. reset 按键 GPIO（当前暂用 GPIO0，与原厂 DTS 的 gpio-keys 一致前需核实）
 *   2. LED 的 GPIO 与颜色（原厂 DTS 无 gpio-leds 节点，灯由用户态控制）
 *   3. 光模块 BOSA 的 I2C 地址（0x50/0x51）与 tx-disable 引脚（暂用 GPIO15）
 *   4. factory(UBI 卷 fhdata) 里 MAC/SN/校准的 nvmem 布局，未接上前 MAC 为随机
 *   5. 2.5G PHY EN8811H 的 MDIO 地址（暂用 0xf）与复位 GPIO（暂用 34）
 */
/dts-v1/;

/* Firmware/ATF 占用 DRAM 前 2 MiB。 */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7583.dtsi"

/ {
	model = "FiberHome HG5380A";
	compatible = "fiberhome,hg5380a", "airoha,an7583";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;	/* 512 MiB */
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			/* TODO: 原厂 reset 键 GPIO 待确认 */
			gpios = <&an7583_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&an7583_pinctrl {
	gpio-ranges = <&an7583_pinctrl 0 2 53>;

	pon_pins: pon-pins {
		mux {
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio0_pins: mdio0-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
		/*
		 * "gpio2" 是从原厂 DTB 里抄来的：
		 *
		 *   mdio-pins {
		 *           mux { function = "mdio"; groups = "mdio"; };
		 *           conf { pins = "gpio2"; output-high; };
		 *   };
		 *
		 * 原厂在配置 MDIO 引脚时额外把 gpio2 拉高，很可能是本板的
		 * PHY 复位释放/供电使能脚。官方 EVB DTS 这里是 "mdio_0"，
		 * 两个都保留，互不影响。
		 */
		conf {
			pins = "mdio_0", "gpio2";
			output-high;
		};
	};

	i2c0_pins: i2c0-pins {
		mux {
			function = "i2c";
			groups = "i2c0";
		};
	};

	spi_pins: spi-pins {
		mux {
			function = "spi";
			groups = "spi";
		};
	};
};

&snfi {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins>;
};

&spi_nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x280000>;
			read-only;
		};

		partition@280000 {
			label = "bootflag";
			reg = <0x280000 0x80000>;
		};

		partition@300000 {
			label = "KernelA";
			reg = <0x300000 0x600000>;
		};

		partition@900000 {
			label = "RootfsA";
			reg = <0x900000 0x2800000>;
		};

		partition@3100000 {
			label = "KernelB";
			reg = <0x3100000 0x600000>;
		};

		partition@3700000 {
			label = "RootfsB";
			reg = <0x3700000 0x2800000>;
		};

		partition@5f00000 {
			label = "apps";
			reg = <0x5f00000 0x6800000>;
		};

		partition@c700000 {
			label = "frameworka";
			reg = <0xc700000 0x1000000>;
		};

		partition@d700000 {
			label = "frameworkb";
			reg = <0xd700000 0x1000000>;
		};

		/* UBI 单卷 "fhdata"：MAC / SN / 光学校准，只读保留 */
		partition@e700000 {
			label = "factory";
			reg = <0xe700000 0x500000>;
			read-only;
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;

	hg5380a_bosa: optical-front-end@51 {
		compatible = "fiberhome,hg5x-bosa", "airoha,paged-bosa";
		reg = <0x51>;

		/* TODO: BEN 极性、tx-disable GPIO 待上机确认 */
		fiberhome,ben-active-high;
		tx-disable-gpios = <&an7583_pinctrl 15 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&mdio_0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;

	/*
	 * Airoha EN8811H 2.5G PHY —— Clause 45 (C45) 器件。
	 *
	 * 必须显式声明 "ethernet-phy-ieee802.3-c45"，内核才会走
	 * get_phy_c45_ids() 直接读 MMD 寄存器，驱动对 PBUS/固件寄存器的访问
	 * 才成立。写成 compatible = "ethernet-phy-id03a2.a411" 会让
	 * fwnode_get_phy_id() 解析成功，走 phy_device_create(..., 0, NULL)
	 * 把 is_c45 硬编码成 0，MMD 访问退化成 C22 间接窗口，固件写不进 PBUS，
	 * 表现为 "MCU not ready: 0x0" / "Load firmware failed: -19"。
	 *
	 * 地址与复位是从原厂固件里挖出来的（mtd2 = KernelA，DTB 偏移 12544，
	 * 反编译后 model 为 airoha,an7583_evb）：
	 *
	 *   mdio-bus {
	 *           compatible = "airoha,arht-mdio";
	 *           phy@13 { reg = <0x0d>; };
	 *           phy@14 { reg = <0x0e>; };
	 *           phy@15 { reg = <0x0f>; };
	 *   };
	 *
	 * 原厂把 0x0d / 0x0e / 0x0f 三个地址都声明出来，且全都没有
	 * compatible、也没有 reset-gpios。官方 EVB DTS 只写 0x0f 且带
	 * reset-gpios = <&an7583_pinctrl 28 GPIO_ACTIVE_LOW>。
	 *
	 * 因此这里先按原厂做法：三个地址都探测、都不加 reset-gpios。
	 * 若 GPIO28 并不是本板的 PHY 复位脚，内核反而会把它按在复位态，
	 * 导致 MDIO 上一个字节都读不到（phy_id = 0x00000000）。
	 */
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0xf>;
	};

	ethernet-phy@d {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0xd>;
	};

	ethernet-phy@e {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0xe>;
	};
};

&switch {
	status = "okay";
	/*
	 * 这里不要写 pinctrl-0 = <&mdio0_pins>。
	 *
	 * mdio0_pins 归 mdio_0 节点所有（官方 an7583-evb-emmc.dts 就是这么放的）。
	 * 如果 switch 也申请同一个 pin group，第二个请求会被拒绝：
	 *
	 *   pinctrl: pin mdc_0 already requested by ...mdio-bus@c8;
	 *            cannot claim for ...switch
	 *   error -EINVAL: could not request pin 53 (mdc_0)
	 *   mt7530-mmio ...switch: Error applying setting, reverse things back
	 *
	 * switch 探测失败 → 内部 GSW 端口全没了 → EN8811H 也不会被探测到。
	 */
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_phy2 {
	status = "okay";
	interrupts = <2>;
};

&gsw_port3 {
	status = "okay";
	label = "lan3";
};

&gsw_phy3 {
	status = "okay";
	interrupts = <3>;
};

&gsw_port4 {
	status = "okay";
	label = "lan4";
};

&gsw_phy4 {
	status = "okay";
	interrupts = <4>;
};

&gdm3 {
	status = "okay";
	openwrt,netdev-name = "lan1";
	phy-handle = <&en8811>;
	phy-mode = "2500base-x";
};

/*
 * gdm1 是 GSW 交换机的 CPU 口（switch 的 port@6 用 ethernet = <&gdm1>）。
 *
 * 不启用它的话，DSA 在 dsa_register_switch() 里走到
 *
 *     conduit = dsa_port_to_conduit(dp);
 *     if (!conduit)
 *             return -EPROBE_DEFER;      // net/dsa/dsa.c:1259
 *
 * 因为 CPU 口的 conduit 网卡永远不出现，switch 会永久 deferred probe：
 *
 *     platform 1fb58000.switch: deferred probe pending: (reason unknown)
 *
 * 结果不仅 lan2~lan4 没有，连 switch 自己的 mdio 总线（内部 PHY 9~12）
 * 也不会注册，外部 PHY 也跟着受影响。
 */
&gdm1 {
	status = "okay";
};

&eth {
	status = "okay";
};

/*
 * AN7583 NPU（硬件转发加速）—— 暂时关闭。
 *
 * 上机实测：status = "okay" 时内核日志停在
 *
 *   [    1.793156] airoha-npu 1e900000.npu: NOTICE:  Get secure key in flash
 *
 * 之后再无任何输出，看门狗复位，系统起不来。这是 NPU 驱动在从 flash 读
 * secure key 之后挂死，与以太网/PHY 无关。
 *
 * 对比历史版本也印证这一点：run17（NPU 关闭）能进用户态，run20（NPU 打开）
 * 从未引导成功。等 LAN/PON 验证完再单独调 NPU，不要让它挡住主线。
 */
&npu {
	status = "disabled";
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&hg5380a_bosa>;
	data-path = <&gdm2>;
	status = "okay";
};

&gdm2 {
	airoha,pon-data-path;
	status = "okay";
};
