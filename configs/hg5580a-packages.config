CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y

# --- accounting / sharing / disk ---
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_vnstat=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_hdparm=y

# --- Python 3 runtime: omitted (ImmortalWrt python3 needs ffi.h from libffi at build time) ---

# --- Python 3 runtime (libffi is vendored by the workflow) ---
CONFIG_PACKAGE_libffi=y
CONFIG_PACKAGE_python3-light=y
CONFIG_PACKAGE_python3-pkg-resources=y
CONFIG_PACKAGE_python3-xml=y
CONFIG_PACKAGE_python3-email=y
CONFIG_PACKAGE_python3-urllib=y
CONFIG_PACKAGE_python3-codecs=y
CONFIG_PACKAGE_python3-openssl=y

# --- theme ---
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# --- LuCI 本体与 Web 服务器 ---
#
# 之前只选了 luci-base，结果镜像里有 243 个 LuCI 文件，却没有
# /usr/sbin/uhttpd —— 网页打不开。原因是 luci-base 的依赖只有
# rpcd/ucode/cgi-io/liblucihttp，**不含任何 Web 服务器**；
# 真正带 uhttpd 的是 luci-light 这个集合：
#
#   feeds/luci/collections/luci-light/Makefile
#       LUCI_DEPENDS := +luci-app-firewall +luci-mod-admin-full
#                       +luci-proto-ppp +luci-theme-bootstrap
#                       +rpcd-mod-rrdns +uhttpd +uhttpd-mod-ubus
#
# 所以这里直接选 luci-light，让依赖自己把 uhttpd 带进来，
# 不要手写 CONFIG_PACKAGE_uhttpd=y —— 那样 uhttpd-mod-ubus
# 不会跟着来，LuCI 的 ubus RPC 仍然不通。
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-uhttpd=y

# --- homebox 内网测速（自带 aarch64 静态二进制 + LuCI 页面）---
#
# 包在 package/homebox，不走 feed。二进制已确认：
#   ELF 64-bit LSB executable, ARM aarch64, statically linked
# 与 AN7583 匹配，14 MB，装进 /usr/bin/homebox。
CONFIG_PACKAGE_homebox=y

# --- IPTV 组播 ---
#
# igmpproxy 做 IGMP 代理，把上游组播引到 LAN；
# udpxy 把 UDP 组播流转成 HTTP，供内网任意设备播放。
# luci-app-udpxy 提供配置界面。
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y

# python3 uses --with-system-ffi and needs the target libffi headers

