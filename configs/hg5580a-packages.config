# HG5380A 的软件包清单（只有 CONFIG_PACKAGE_* 行，不含任何平台/设备配置）
#
# 用途：build-hg5380a.yml 的 full 档位把它 grep 进 .config，追加要装的软件包。
# 不影响 target、内核、板级定义 —— 那些在 configs/an7583.config 里。
#
# 本文件早先叫 an7581-tyfza1-packages.config，容易让人误以为把 TYFZA1
# 的固件配置混进了 5380A。实际上它是与硬件无关的通用包清单，
# 文件名带 tyfza1 纯属历史原因，故改名为 hg5380a-packages.config。
# 包名在本仓库 feeds 里不存在的，会被 make defconfig 静默丢弃，不会导致失败。

# --- throughput / diagnostics ---
CONFIG_PACKAGE_iperf=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_luci-app-commands=y

