# HG5580A 的软件包清单
#
# 用途：构建脚本把它 grep 进 .config，追加要装的软件包。
# 只含 CONFIG_PACKAGE_* 行，不含任何平台 / 设备 / 内核配置。
#
# ============================================================
# 选包依据：HG5580A 的实际硬件（2026-11-08 在设备上实测）
# ============================================================
#
#   SoC        Airoha AN7583，Cortex-A53 ×2
#   内存       512 MiB（可用 429 MiB）
#   闪存       SPI-NAND 256 MiB
#   有线       lan1 = YT8821 2.5G，lan2/3/4 = SoC 内建 1G
#   无线       无
#   PON        光口 XG-PON（UX3363 BOSA）
#   SATA       无（/sys/class/ata_port 为空）
#   MMC/SD     无（/sys/class/mmc_host 为空）
#   PCI        无（lspci 为空）
#   USB        SoC 有 2 个控制器（usb1/usb2），但机壳无物理接口
#
# 因此下面这些一律不选，选了就是白占 rootfs：
#   - 所有 USB 相关：存储、网卡、串口、调制解调器
#   - 所有 SATA / 硬盘相关：hdparm、smartmontools、hd-idle
#   - 3G/4G 拨号：comgt、umbim、uqmi、luci-proto-{3g,mbim,ncm,qmi}
#   - 用不到的文件系统：btrfs、xfs、f2fs（只保留 ext4/vfat/exfat/ntfs3）
#   - 单 WAN 设备用不上：mwan3
#
# ============================================================
# 一、基础工具
# ============================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_luci-app-commands=y

# --- 测速 ---
# iperf 与 iperf3 在本仓库里是两个不同的 feed 目录，容易混淆：
#   feeds/packages/net/iperf   -> iperf 2.2.1，生成包 iperf
#   feeds/packages/net/iperf3  -> PKG_NAME 也叫 iperf，版本 3.22，
#                                 但 BuildPackage 用的是 iperf3 / iperf3-ssl
# 两个 CONFIG 都要写才能同时拿到 iperf2 和 iperf3。
CONFIG_PACKAGE_iperf=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iperf3-ssl=y

# --- homebox 内网测速（自带 aarch64 静态二进制 + LuCI 页面）---
# 包在 package/homebox，不走 feed。二进制已确认：
#   ELF 64-bit LSB executable, ARM aarch64, statically linked
CONFIG_PACKAGE_homebox=y

# --- IPTV 组播 ---
# igmpproxy 做 IGMP 代理，把上游组播引到 LAN；
# udpxy 把 UDP 组播流转成 HTTP，供内网任意设备播放。
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y

# ============================================================
# 二、文件系统（只留实际会用到的）
# ============================================================
# ext4  : overlay 之外的 U 盘/移动盘常见格式
# vfat  : FAT32
# exfat : 大容量 U 盘/存储卡
# ntfs3 : Windows 格式
# 都是内核内置支持，不加 kmod-fs-btrfs/xfs/f2fs 能省约 2 MB。
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_ntfs-3g=y

# ============================================================
# 三、透明代理（homeproxy + sing-box）
# ============================================================
# 原先用 openclash：单包 7.95 MB，还拖进 ruby（libruby 1.44 MB + 一堆
# ruby-*）、bash 0.47 MB、curl、dnsmasq-full、unzip，合计约 10 MB，
# 让 rootfs 从 7.0 MB 涨到 36.3 MB，而 RootfsX 只有 40 MiB。
#
# homeproxy 的依赖只有 sing-box，不需要 lua 运行时，也不用替换 dnsmasq，
# 功能覆盖 ss / vmess / trojan / hysteria / tuic。
#
# 注意 sing-box 的坑：feeds 里 full 变体的
#     config SING_BOX_BUILD_NAIVE_OUTBOUND
#     def_bool y
# 每次 make defconfig 都会打开，而它带条件依赖
#     DEPENDS += +SING_BOX_BUILD_NAIVE_OUTBOUND:libcronet
# 于是 libcronet 被无条件拉入，编译时要去
# commondatastorage.googleapis.com 下载 Chromium clang 工具链，必然卡死。
# 解法是改用 tiny 变体（PROVIDES:=sing-box，能满足依赖）：
#     # CONFIG_PACKAGE_sing-box is not set
#     CONFIG_PACKAGE_sing-box-tiny=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box-tiny=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-tun=y

# openclash 及其重依赖全部去掉：
# CONFIG_PACKAGE_luci-app-openclash
# CONFIG_PACKAGE_ruby
# CONFIG_PACKAGE_ruby-yaml
# CONFIG_PACKAGE_luci-compat
# CONFIG_PACKAGE_luci-lua-runtime
# CONFIG_PACKAGE_luci-lib-ipkg
# CONFIG_PACKAGE_bash
# CONFIG_PACKAGE_unzip

# --- NAT / conntrack 辅助 kmod（tproxy 与常见 P2P 需要）---
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y

# ============================================================
# 四、管理界面
# ============================================================
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y

# --- theme ---
# luci-theme-argon 的 Provides 里已经包含 luci-app-argon-config，不用单独选。
CONFIG_PACKAGE_luci-theme-argon=y

# --- LuCI 本体与 Web 服务器 ---
#
# 只选 luci-base 会得到 243 个 LuCI 文件却没有 /usr/sbin/uhttpd，网页打不开：
# luci-base 的依赖只有 rpcd/ucode/cgi-io/liblucihttp，不含任何 Web 服务器。
# 真正带 uhttpd 的是 luci-light：
#   LUCI_DEPENDS := +luci-app-firewall +luci-mod-admin-full
#                   +luci-proto-ppp +luci-theme-bootstrap
#                   +rpcd-mod-rrdns +uhttpd +uhttpd-mod-ubus
# 所以选 luci-light，让依赖把 uhttpd 和 uhttpd-mod-ubus 一起带进来。
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-uhttpd=y

# ============================================================
# 五、QoS / 统计 / 共享
# ============================================================
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y

CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
# vnstat 由 luci-app-vnstat2 依赖自动拉入，不用单独写
CONFIG_PACKAGE_luci-app-vnstat2=y

# 只保留 SMB，去掉 NFS（无 SATA，共享只能基于 overlay，价值不大）
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
