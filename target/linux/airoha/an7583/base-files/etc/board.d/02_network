. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

an7583_setup_interfaces()
{
	local board="$1"

	case "$board" in
	airoha,an7583-evb)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4 eth1"
		;;
	nokia,xg-040g-mf|\
	nokia,xg-040g-mf-ubi|\
	fiberhome,hg5380a|\
	fiberhome,hg5380a-ubi|\
	fiberhome,hg5580a|\
	fiberhome,hg5580a-ubi)
		# Add the copper ports to br-lan and bind wan directly to pon0.
		# Opening wan starts the pon0 PMA, PLOAM, and OMCI lifecycle.
		#
		# The -ubi variants must be listed explicitly: board_name comes from
		# the DTS root compatible, and the UBI images set
		#
		#     compatible = "fiberhome,hg5580a-ubi", "airoha,an7583";
		#
		# so matching only "fiberhome,hg5580a" falls through to the *)
		# branch and prints "Unsupported hardware. Network interfaces not
		# initialized".  The visible effect is that /etc/config/network is
		# never created, lan2/lan3/lan4 stay uninitialised, br-lan has no
		# address, and LuCI is unreachable on 192.168.1.1 -- while the serial
		# console looks perfectly healthy, which makes it easy to misread as a
		# firewall or uhttpd problem.
		# lan1 是 GDM3 + YT8821 的 2.5G 电口，必须一起放进 br-lan。
		#
		# 漏掉 lan1 的后果不是"少一个口"，而是整个管理面消失：接口不在任何
		# bridge 里，netifd 就不会把它 set up，phylink 也就永远停在
		# phylink_create() 之后的未启动状态 —— 网口 LED 不亮、carrier 读出来
		# 是 "Invalid argument"（没有 phydev 接到 netdev）、dmesg 里连
		# "configuring for ... link mode" 都不会出现。现象看起来像是 PHY
		# 或 SerDes 没驱动起来，实际只是没人 ifup 过它。
		#
		# 手工验证过（2026-11-11，lan1 插 2.5G 电口）：
		#     uci add_list network.@device[0].ports=lan1; uci commit; ifup lan
		# 立刻得到
		#     lan1: configuring for phy/2500base-x link mode
		#     lan1: Link is Up - 2.5Gbps/Full - flow control rx/tx
		#     br-lan: port 1(lan1) entered forwarding state
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "pon0"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
an7583_setup_interfaces $board
board_config_flush

exit 0