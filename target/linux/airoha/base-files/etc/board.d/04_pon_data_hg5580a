#!/bin/sh
# HG5380A / HG5580A：给板级数据工具补上 pon_data 目标（校准表读写用）
#
# 用 /proc/mtd 判断而不是 board_name：上游 03_pon_data 里没有这两款，
# 而且 board_name 在 board.d 的执行环境里不一定可用。
#
# 大小必须与 DTS 的分区声明一致，否则板级数据页面会按错的大小读写：
#   bosacal   0xEC00000 + 0x00040000 = 256 KiB
#   identity  0xEC40000 + 0x00040000 = 256 KiB
#
# 历史：最初写成 128 KiB（0x20000），与页面显示的 256 KiB 不符，已改正。

. /lib/functions/uci-defaults.sh

[ -r /proc/mtd ] || exit 0
grep -q '"bosacal"'  /proc/mtd 2>/dev/null || exit 0
grep -q '"identity"' /proc/mtd 2>/dev/null || exit 0

board_config_update

json_select pon_data 2>/dev/null || json_add_object pon_data

json_add_object bosacal
json_add_string type mtd
json_add_int size 262144
json_close_object

json_add_object identity
json_add_string type mtd
json_add_int size 262144
json_close_object

json_close_object

board_config_flush

exit 0
