/*
 * Shared hardware description for the FiberHome HG5580A.
 *
 * Partition tables live in separate files so the stock layout and the UBI
 * layout can share this file:
 *
 *   an758x-fiberhome-hg5580a-stock-parts.dtsi   stock 14 partitions,
 *                                               JFFS2/JFFS2-on-overlay
 *   an758x-fiberhome-hg5580a-ubi-parts.dtsi     bl2 + one 190.5 MiB UBI window
 *                                               ending at "factory", fitblk rootfs
 */

// SPDX-License-Identifier: GPL-2.0-only OR MIT
/*
 * FiberHome HG5580A — Airoha AN7583
 *
 * 这份 DTS 以 HG5380A 的移植成果（board/an7583-fiberhome-hg5380a.dts）为底稿，
 * 按本机原厂 KernelA 里 DTB 的反编译结果（备份见
 * backup/vendor-an7583-hg5580a.dtb / .dts，15704 字节，位于 KernelA 0x3100）
 * 逐条校对后修改。
 *
 * 硬件已确认的共同点（来自原厂 DTB / U-Boot / Linux 启动日志）：
 *   - SoC AN7583，512 MiB DDR，SPI-NAND FORESEE F35SQB002G (0xCD/0x52)
 *   - 10 个原厂分区，偏移与 HG5380A 完全一致
 *   - BOSA 在 i2c0 地址 0x51（分页 0x7f，chip id 读 0xA4）
 *   - PON 为 XEPON_10G_1G，SerDes 走 xpon_usxgmii
 *   - LAN2~LAN4 的 LED 由交换芯片内部 PHY 的 led0 功能驱动
 *     （原厂 pinctrl 组 gswp1..gswp4-led0-pins 与本文件相同）
 *
 * 原厂 HG5580A DTB 里 GPIO 相关节点（与 HG5380A 的差异点，务必上机复核）：
 *   leds/pwr_led              gpios = <&gpio 30 ...>   // power_gpio=1e
 *   leds/phy_tx_power_disable gpios = <&gpio 15 ...>   // dsl_gpio=0b? 见下
 *   leds/an8811_reset         gpios = <&gpio 28 ...>
 *   gpio-keys-polled/reset_   gpios = <&gpio 0 ...>
 *   mdio-bus: phy@13(reg 0x0d), phy@14(reg 0x0e), phy@15(reg 0x0f)
 *
 * TODO(上机确认)：
 *   1. 【已实测】2.5G PHY = Motorcomm YT8821，MDIO 地址 0x07，ID 0x4f51ea19。
 *      U-Boot `mii read` 实测寄存器组：
 *          0x07: reg0=0x1040 reg1=0x7949 reg2=0x4F51 reg3=0xEA19 reg4=0x11E1
 *      与 HG5380A 完全一致，可放心套用 kmod-phy-motorcomm。
 *      注意：地址 0x00 读回同一组值（MDIO 地址低位未完全译码），0x0F 全 0
 *      （印证原厂 "Could not get PHY ... addr 15"），0x09 是另一颗器件。
 *      沿用 0x07（与 5380A 参考设计一致），若启动后 PHY 认不到再改 0x00。
 *   2. reset 键 GPIO —— 【U-Boot 阶段读不到，与 HG5380A 情况相同】
 *      原厂 DTB 写 GPIO0；本机用 U-Boot `gpio input` 在按键时轮询了
 *      0/8/16/17/30/33/34/35/36/37/38 共 11 个引脚（955 次采样），
 *      连按多次均无任何电平变化 —— 说明 U-Boot 没有正确 pinmux 这个按键，
 *      它的电平在 U-Boot 里是"死"的。
 *      HG5380A 当年也是同样现象，最后是在 Linux 里数 /proc/interrupts
 *      的 IRQ 增量才定位到 GPIO35 的。
 *      因此这里沿用 GPIO35（5380A 实测值），**上机后必须复核**：
 *        短按复位键，看 /proc/interrupts 里 gpio-keys 的计数是否 +1；
 *        不增长就把 35 依次换成 0/34/36/37 再试（改本文件后重新编译）。
 *      注：按键走 OpenWrt 的 gpio-button-hotplug，config 里已关掉内核
 *      自带的 gpio-keys 驱动。
 *   3. 光信号(LOS)灯 GPIO（HG5380A 是 GPIO33，本机原厂 DTB 里没有这个节点）
 *   4. 光宽带灯 PWM 通道（原厂 pwmleds 用 PWM 通道 10、周期 0x3d0900，
 *      与 HG5380A 相同，但仍需确认 gpio18 是否被 PON 组占用）
 *   5. factory(UBI 卷 fhdata) 里 MAC/SN 的实际值，未接上之前 MAC 是随机的
 *   6. bosacal / identity 两个自建分区在 256 MiB flash 尾部空闲区，
 *      偏移沿用 HG5380A（0xEC00000 / 0xEC20000），本机未写入过，安全
 */
/dts-v1/;

/* Firmware/ATF 占用 DRAM 前 2 MiB。 */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7583.dtsi"

/ {
	model = "FiberHome HG5580A";
	compatible = "fiberhome,hg5580a", "airoha,an7583";

	aliases {
		serial0 = &uart1;
	};

	fh_chosen: chosen {
		/*
		 * bootargs is intentionally NOT set here.
		 *
		 * dtc merges properties per node, so if both this file and a
		 * variant's &chosen set bootargs the winner depends on emission
		 * order.  In practice the shared value won and the UBI image
		 * shipped with root=/dev/mtdblock5 rootfstype=squashfs, i.e. it
		 * looked for a partition that layout does not have.
		 *
		 * Single writer: each variant sets the full cmdline in its own
		 * parts file.
		 */
		/*
		 * RootfsB 上的 squashfs。initramfs 镜像会忽略这两个参数
		 * （内核优先跑 initramfs 里的 /init），所以同一条 DTS 可以同时
		 * 服务两种镜像。
		 *
		 * mtdblock 编号必须按本 DTS 的 partitions 子节点顺序数，不能照抄
		 * 别的板子。实际顺序是：
		 *   mtd0 bootloader  mtd1 bootflag   mtd2 KernelA   mtd3 RootfsA
		 *   mtd4 KernelB     mtd5 RootfsB    mtd6 apps      mtd7 rootfs_data
		 *   mtd8 frameworka  mtd9 frameworkb mtd10 factory
		 *   mtd11 bosacal    mtd12 identity
		 * 原先这里写的是 mtdblock6，那是 apps；改成 mtdblock5 指向 RootfsB。
		 * 正常启动时 bargsenv 会按 rootfs_partition_name 覆盖本行，
		 * 但覆盖失效时这个值就会真的被用上，所以必须是正确的。
		 */
		/*
		 * Only the console lives here.  The root specification differs
		 * between variants -- the stock layout boots from RootfsB with a
		 * JFFS2 overlay partition, the UBI layout gets its root from the
		 * UBI "fit" volume via fitblk.  Each variant appends its own in
		 * its parts file.
		 */
		/*
		 * Console only.  Each variant writes the full bootargs in its
		 * parts file, because a bare bootargs-append here would collide
		 * with the platform dtsi and one of them would be dropped.
		 */
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;	/* 512 MiB */
	};

	/*
	 * 前面板指示灯。电源灯由硬件常亮，不受 GPIO 控制。
	 * 光信号灯默认用 HG5380A 实测可用的 GPIO33（低有效），
	 * 本机若实测不对，改这里即可（见文件头 TODO 3）。
	 */
	leds {
		compatible = "gpio-leds";

		/*
		 * 【历史说明，保留以便对照原厂 DTS】
		 *
		 * 原厂这里有两个节点：
		 *   leds/an8811_reset           GPIO28 低有效 default-state="off"
		 *   leds/phy_tx_power_disable   GPIO15 高有效 default-state="on"
		 *
		 * 名字里的 "an8811" 是原厂沿用的旧称，本机实测 PHY 是
		 * Motorcomm YT8821（ID 0x4f51ea19 @ MDIO 0x07）。
		 *
		 * 两个节点都已被移出 gpio-leds：
		 *
		 *   an8811_reset   -> 改成 PHY 节点的 reset-gpios，见 &mdio_0 下面
		 *                     yt8821 的说明。用 leds 间接拉高只是电平对，
		 *                     驱动拿不到 reset_gpio，那次硬复位从来没执行。
		 *
		 *   phy_tx_power_disable
		 *                  -> 改成 BOSA 节点的 tx-disable-gpios，见
		 *                     hg5580a_bosa。原厂名字和电平是反的（叫
		 *                     disable 但高有效且 on，即驱动为高），保留原厂
		 *                     写法便于逐行对照。
		 *
		 * 电平行为都不变，变的只是"谁持有这根线"，以及由此带来的
		 * 驱动内部状态。同一个 GPIO 不能被两个消费者同时持有。
		 */


		/*
		 * an8811_reset（GPIO28 低有效）不再写成 LED 节点。
		 *
		 * 原做法是靠 leds-gpio 的 "低有效 + default-state=off" 把线间接
		 * 拉高，效果只是"复位释放"，而且只在 LED 类探测时发生一次。
		 * motorcomm 的 yt8821_config_init() 却要靠 phy_device_reset()
		 * 做一次真实的复位脉冲来清掉 MDIO 总线冲突留下的寄存器污染，
		 * 那个函数只在 PHY 节点有 reset-gpios 时才动作。
		 *
		 * 现在复位线绑在 &mdio_0 下面的 yt8821 节点上：
		 *
		 *     reset-gpios = <&an7583_pinctrl 28 GPIO_ACTIVE_LOW>;
		 *
		 * 同一个 GPIO 不能被两个消费者同时持有（后者 -EBUSY），所以这个
		 * LED 节点必须删掉。它本来也不是指示灯，名字是原厂沿用的旧称。
		 *
		 * 电平行为不变：低有效 + 驱动释放复位 = 引脚输出高。
		 */

		/*
		 * 电源灯：原厂 DTS 用 GPIO30(0x1e)、低有效、default-state="on"。
		 * 实测电源灯常亮，即使不驱动也亮（硬件上拉），所以不是必需项，
		 * 但按原厂写出来更接近真实硬件行为。
		 */
		pwr_led {
			label = "power";
			function = LED_FUNCTION_POWER;
			gpios = <&an7583_pinctrl 30 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_los: los {
			label = "green:los";
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&an7583_pinctrl 33 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-los";
		};
	};

		/*
	 * reset 键：**GPIO35**，低有效。
	 *
	 * 这里有一个容易踩的坑，值得写清楚：
	 * 从 CRC 全验证的 KernelA 分区重新导出的厂商 DTB 里，
	 * reset_ 节点写的是 gpios = <&pinctrl 0x00 0x01>，即 GPIO0；
	 * HG5380A 的厂商 DTB 也是同样的 GPIO0。
	 * 但 HG5380A 是**本仓库里已验证能工作**的机型，它的板级 DTS
	 * 用的是 GPIO35 —— 那个值不是抄的厂商 blob，是上机实测出来的。
	 *
	 * 结论：在这颗芯片的原厂 DTB 里，"0" 并不等于物理 GPIO0。
	 * 为了"跟厂商一致"改成 0，会破坏一个已验证可用的按键，
	 * 而且 GPIO0 在 U-Boot 阶段本身就读到过的是固定电平。
	 * 所以保持 GPIO35。
	 *
	 * TODO(上机确认)：5580A 首次启动后，按住复位键看
	 *   /proc/interrupts 或 evtest 是否报 KEY_RESTART；
	 * 若确实不是 35，再按实测值改。
	 */
	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&an7583_pinctrl 35 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&an7583_pinctrl {
	gpio-ranges = <&an7583_pinctrl 0 2 53>;

	pon_pins: pon-pins {
		mux {
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio0_pins: mdio0-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
		conf {
			pins = "mdio_0";
			output-high;
		};
	};

	i2c0_pins: i2c0-pins {
		mux {
			function = "i2c";
			groups = "i2c0";
		};
	};

	i2c1_pins: i2c1-pins {
		mux {
			function = "i2c";
			groups = "i2c1";
		};
	};

	spi_pins: spi-pins {
		mux {
			function = "spi";
			groups = "spi";
		};
	};

	pwm_gpio18_pins: pwm-gpio18-pins {
		mux {
			function = "pwm";
			pins = "gpio18";
			output-enable;
		};
	};
};

&snfi {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins>;
};

&spi_nand {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;

	/*
	 * 光模块：原厂 fhdrv_bosa_driver_init.sh 的判断表
	 *   0x28 -> gn28l95   0x98 -> gn28l98
	 *   0x2e -> ux3361    0x96 -> gn25l96
	 *   0x20 -> ux3320    0x02 -> ux3322
	 * 地址 0x51、分页 0x7f、chip id 读 0xA4。
	 *
	 * 【型号存疑，待上机确认】两处证据互相矛盾：
	 *   - 口头说法：本机光模块是 3361（UX3361），对应 chip id 0x2e
	 *   - 设备自己的记录：factory/fhdata 里的 table 文件写的是 ux3363
	 * 后者是厂商在出厂时写进 flash 的型号字符串，通常比口头描述可靠。
	 * 但 U-Boot 没有 i2c 命令（94 条命令里没有），当前无法读 0xA4 验证，
	 * 只能等 PonWRT 起来后实测。驱动按 paged-bosa 通用方式工作，
	 * 型号差异主要影响校准系数的解释，不影响能否驱动。
	 */
	hg5580a_bosa: optical-front-end@51 {
		compatible = "fiberhome,hg5x-bosa", "airoha,paged-bosa";
		reg = <0x51>;

		/* 原厂 phy_tx_power_disable = GPIO15，默认拉高（关发射） */
		fiberhome,ben-active-high;
		tx-disable-gpios = <&an7583_pinctrl 15 GPIO_ACTIVE_HIGH>;

		/*
		 * 本机的校准表是 FiberHome 自家容器（"fiberhomebdbob"），
		 * 不是 Airoha 的 "APONCAL"。驱动默认两种都不接受，
		 * 只有显式声明这个属性才走 BDBOB 解析路径
		 * （board/airoha-paged-bosa-bdbob-calibration.patch）。
		 *
		 * 只在本机型设置：其他用 UX3363/GN28L95 的机型继续走严格
		 * 的 APONCAL 校验，行为完全不变。
		 */
		fiberhome,bdbob-calibration;

		nvmem-cells = <&bosa_calibration>;
		nvmem-cell-names = "calibration";
		status = "okay";
	};
};

&i2c1 {
	status = "disabled";
};

&usb_phy {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&mdio_0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;

	/*
	 * 2.5G PHY —— 已实测确认。
	 *
	 * U-Boot `mii read` 扫全总线结果（2026-11-05）：
	 *   0x07: reg0=0x1040 reg1=0x7949 reg2=0x4F51 reg3=0xEA19 reg4=0x11E1
	 *   => PHY ID 0x4f51ea19 = Motorcomm YT8821（2.5G），与 HG5380A 同款
	 *   0x00 读回同一组值（地址低位未完全译码，属于总线别名）
	 *   0x0F 全 0x0000（印证原厂 "Could not get PHY ... addr 15"）
	 *   0x09 是另一颗器件（reg3=0x0420 reg4=0x0DE1），不是 2.5G PHY
	 *
	 * 沿用 0x07（与 5380A 参考设计一致）。若启动后 PHY 认不到，改 0x00 即可。
	 * 用 "ethernet-phy-ieee802.3-c22" 让内核自己读 ID，读到 0x4f51ea19
	 * 就会绑上 motorcomm 驱动（DEVICE_PACKAGES 里已带 kmod-phy-motorcomm）。
	 *
	 * 【reset-gpios 为什么必须写在这里】
	 *
	 * 本板的 PHY 复位是 GPIO28、低有效。之前这个引脚只出现在 gpio-leds 的
	 * an8811_reset 节点里，靠 "低有效 + default-state=off" 间接把线拉高，
	 * 等于只在 LED 类探测时驱动一次，PHY 驱动自己完全不知道有复位线。
	 *
	 * 后果直接写在 motorcomm 的 yt8821_config_init() 里：
	 *
	 *     phy_device_reset(phydev, 1);      // 拉低复位
	 *     ...
	 *     phy_lock_mdio_bus(phydev);
	 *     phy_device_reset(phydev, 0);      // 释放复位
	 *     ytphy_modify_ext(..., YTPHY_MACR_EN_PHY_ADDR_0, 0);
	 *     phy_unlock_mdio_bus(phydev);
	 *     ...
	 *     yt8821_serdes_init(phydev);
	 *     yt8821_utp_init(phydev);
	 *
	 * phy_device_reset() 只有在 PHY 设备声明了复位 GPIO 时才动作。没有
	 * reset-gpios 时它什么也不做，驱动以为自己完成了一次硬复位，实际
	 * 芯片状态取决于上电默认值和 LED 类的驱动时序。MDIO 总线冲突导致的
	 * 寄存器污染也就清不掉——而这家驱动的注释正说明硬复位就是为了清理
	 * 这种污染。
	 *
	 * 这片树里其他板子都在 PHY 节点上写 reset-gpios，an7583-evb-emmc.dts
	 * 用的就是同一个引脚：
	 *
	 *     reset-gpios = <&an7583_pinctrl 28 GPIO_ACTIVE_LOW>;
	 *
	 * 所以这里照同样的写法补上。加上之后 GPIO28 由 PHY 驱动持有，上面
	 * 那个 leds/an8811_reset 节点就不能再申请同一个引脚（同一引脚被两个
	 * 消费者申请，第二个会 -EBUSY），因此它已被删除，见文件顶部的说明。
	 */
	yt8821: ethernet-phy@7 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x7>;
		reset-gpios = <&an7583_pinctrl 28 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
	};
};

&switch {
	status = "okay";
	/*
	 * 不要在这里写 pinctrl-0 = <&mdio0_pins>：该 pin group 已归 mdio_0，
	 * 同一组被两个设备申请时第二个会 -EINVAL，switch 探测失败。
	 */
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_phy2 {
	status = "okay";
	interrupts = <2>;
};

&gsw_port3 {
	status = "okay";
	label = "lan3";
};

&gsw_phy3 {
	status = "okay";
	interrupts = <3>;
};

&gsw_port4 {
	status = "okay";
	label = "lan4";
};

&gsw_phy4 {
	status = "okay";
	interrupts = <4>;
};

&gdm3 {
	status = "okay";
	openwrt,netdev-name = "lan1";
	phy-handle = <&yt8821>;

	/*
	 * phy-mode 必须是 2500base-x，不能改成 2500base-t。
	 *
	 * 这里的 phy-mode 描述的是 MAC <-> PHY 之间的接口，不是网线上的介质。
	 * Airoha 的 MAC 只实现了有限的几种接口模式，见
	 * drivers/net/ethernet/airoha/airoha_eth.c 里注册的 phylink 支持列表：
	 *
	 *     PHY_INTERFACE_MODE_INTERNAL
	 *     PHY_INTERFACE_MODE_SGMII
	 *     PHY_INTERFACE_MODE_1000BASEX
	 *     PHY_INTERFACE_MODE_2500BASEX      <- 只有这个
	 *     PHY_INTERFACE_MODE_10GBASER
	 *     PHY_INTERFACE_MODE_USXGMII
	 *
	 * 里面没有 PHY_INTERFACE_MODE_2500BASET。写成 2500base-t 会让 phylink
	 * 在 phylink_validate() 阶段直接拒绝该接口模式，lan1 根本不会起来。
	 *
	 * 另外这片树里所有 an758x 板子（5380A、5382A、Nokia、H3C、Gemtek、
	 * Unionman、EVB）无一例外都用 2500base-x，也是同一个原因。
	 *
	 * YT8821 的线侧仍然是铜口 2.5GBASE-T：驱动在
	 * yt8821_config_init() 里按 phydev->interface 分支，2500BASEX 时只配置
	 * SerDes 侧，铜口那一侧照常自动协商。所以插普通网线是能协商的。
	 *
	 * 实测记录（2026-11-11，lan1 插 2.5G 电口，修复前）：
	 *   Supported link modes:        2500baseX/Full, 2500baseT/Full
	 *   Advertised auto-negotiation: No
	 *   Auto-negotiation:            off
	 *   Duplex:                      Half
	 *   Link detected:               no
	 * PHY 识别正常（phy_id 0x4f51ea19，driver "YT8821 2.5Gbps PHY"），
	 * MDIO 正常（mdio-bus@c8-mii:07 存在），PCS 正常（eth_pcs okay），
	 * GPIO 电平也正常：
	 *   gpio-28  out hi ACTIVE LOW   复位已释放（当时由 leds 节点驱动）
	 *   gpio-15  out hi              发送已使能
	 *
	 * 但电平对不等于复位发生过。GPIO28 当时归 gpio-leds 的 an8811_reset
	 * 所有，PHY 驱动的 mdio 层拿不到 reset_gpio，于是
	 * mdio_device_reset() 第一行就 return：
	 *
	 *     if (!mdiodev->reset_gpio && !mdiodev->reset_ctrl)
	 *             return;
	 *
	 * yt8821_config_init() 开头那次硬复位（驱动注释写明是为了清掉 MDIO
	 * 总线冲突留下的寄存器污染）因此从未执行，SerDes 初始化跑在一个
	 * 不确定的寄存器基线上。修复见 &mdio_0 下面 yt8821 节点的
	 * reset-gpios，那里有完整说明。
	 */
	phy-mode = "2500base-x";

	nvmem-cells = <&fh_lan_mac>;
	nvmem-cell-names = "mac-address";
};

/*
 * gdm1 是 GSW 交换机的 CPU 口（switch 的 port@6 用 ethernet = <&gdm1>）。
 * 不启用它，DSA 在 dsa_register_switch() 里会因为 conduit 永远不存在而
 * 永久 -EPROBE_DEFER，lan2~lan4 与 switch 的内部 mdio 总线都不会出现。
 */
&gdm1 {
	status = "okay";

	nvmem-cells = <&fh_base_mac>;
	nvmem-cell-names = "mac-address";
};

&eth {
	status = "okay";
};

/*
 * AN7583 NPU（硬件转发加速）—— 关闭。
 *
 * 【结论先行】这块板子上开 NPU 会让设备无法启动，只能停在 U-Boot / 反复重启。
 *
 * 实测记录（2026-11-11，HG5580A）：
 * 把这一节改成 status = "okay" 编译（镜像 33865998 B, md5 0f84fd3ddde3abdfbfa82b14b93b1f5a）
 * 并刷入后，串口能走到
 *
 *     FIT: Selected configuration: "config-1" (OpenWrt fiberhome_hg5580a-ubi)
 *     VFS: Mounted root (squashfs filesystem) readonly on device 259:0.
 *     Run /sbin/init as init process
 *     init: - preinit -
 *
 * 然后停住不再前进，网络完全不通，最后表现为停在 U-Boot 或反复重启。
 * 整段内核日志里没有出现任何 airoha-npu 的 probe 输出，也没有
 * "NPU fw version"，说明它连 probe 都没走完。
 *
 * 这与本项目早先在 HG5380A 上的观察一致（同 SoC、同驱动、同固件）：
 *
 *     airoha-npu 1e900000.npu: NOTICE:  Get secure key in flash
 *     → 看门狗复位
 *
 * 也就是说 5380A 和 5580A 都有这个问题，不是单板偶发。
 *
 * ---------------------------------------------------------------------------
 * 复位后排查过的、确认【不是】原因的部分，留给下次继续：
 *
 * 1. "Get secure key in flash" 这句在当前驱动源码里不存在。
 *    drivers/net/ethernet/airoha/ 与 target/linux/airoha/patches-6.18/
 *    全树 grep 均无命中。所以那句话来自另一版驱动，不能用来判断现在的
 *    失败点，但也不能据此认为问题已消失 —— 实测它仍然起不来。
 *
 * 2. 构建侧是齐的，不是"忘了打包":
 *        CONFIG_NET_AIROHA_NPU=y                （config-6.18）
 *        airoha_npu.o 已链接进 airoha-eth（airoha-eth-y 只含 eth+ppe，
 *        npu 由 obj-$(CONFIG_NET_AIROHA_NPU) 单独进 built-in.a）
 *        /lib/firmware/airoha/an7583_npu_rv32.bin   85432 B < 0x200000
 *        /lib/firmware/airoha/an7583_npu_data.bin    3244 B < 0x10000
 *        固件名与 an7583_npu_soc_data 里 NPU_AN7583_FIRMWARE_* 一致
 *    DTB 也确认过是 status = "okay"（dtc -I dtb -O dts 验过）。
 *
 * 3. 本树已带两条针对性修复，仍未解决:
 *        924-net-airoha-npu-use-coherent-mailbox-dma.patch
 *            mailbox 改 coherent DMA（原来 CPU 写的消息 NPU 可能看不到）
 *        926-net-airoha-npu-bound-mailbox-wait.patch
 *            给 mailbox 等待加时限，避免无限阻塞
 *
 * 4. 同 SoC 其他板子（an7583-evb、an7583-evb-emmc、nokia_xg-040g、
 *    an7581-hg5382a）都写 status = "okay"，但它们都没在这块板子上验证过，
 *    不能当作本板也能开.
 *
 * 下次若要继续调，必须走【不落 flash】的路径（initramfs + U-Boot tftp/
 * XMODEM 引导），确认 NPU 能起来之后再进 sysupgrade，否则每次失败都要
 * 从 U-Boot 恢复。
 * ---------------------------------------------------------------------------
 *
 * 影响面：npu 关闭时 airoha_ppe_init() 走软件路径，基本转发和 NAT 不受
 * 影响，只是没有硬件流表卸载（PPE flow offload）。日常路由/测速不受阻。
 */
&npu {
	status = "disabled";
};

&pon_pcs {
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&xpon_mac {
	/*
	 * PON 引脚复用必须保留：pon_tx_disable_gpio 组把 15/16/18/19/20
	 * 复用成 PON 功能。撤掉后收侧浮空，会把噪声误判成光信号。
	 * 代价：该组含 gpio18，"光宽带"灯 PWM 暂时用不了。
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;

	optical-front-end = <&hg5580a_bosa>;
	data-path = <&gdm2>;

	nvmem-cells = <&fh_pon_serial>;
	nvmem-cell-names = "pon-serial";
	status = "okay";
};

&gdm2 {
	airoha,pon-data-path;
	status = "okay";

	nvmem-cells = <&fh_pon_mac>;
	nvmem-cell-names = "mac-address";
};

/*
 * an7583.dtsi 给 CPU 挂了 operating-points-v2（含 required-opps + genpd），
 * 6.18 的 dt_cpufreq 解析时会踩野指针 panic。摘掉 OPP 引用。
 */
&cpu0 {
	/delete-property/ operating-points-v2;
};

&cpu1 {
	/delete-property/ operating-points-v2;
};

&cpufreq {
	/delete-property/ operating-points-v2;
	status = "disabled";
};

/*
 * PWM 控制器是 system-controller@1fbf0200（syscon）的子节点：
 * 驱动用 device_node_to_regmap(dev->parent) 拿寄存器，不能写在顶层，
 * 也不能带 reg（带了会 probe 失败 -12）。
 */
&{/soc/system-controller@1fbf0200} {
	pwm: pwm {
		compatible = "airoha,en7581-pwm";
		#pwm-cells = <3>;
		status = "okay";
	};
};

/ {
	pwmleds {
		compatible = "pwm-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pwm_gpio18_pins>;
		/* gpio18 已被 PON 引脚组占用，等 pinctrl 补丁后再启用 */
		status = "disabled";

		led_pon: pon {
			label = "green:pon";
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_GREEN>;
			pwms = <&pwm 10 4000000 1>;
			max-brightness = <255>;
			linux,default-trigger = "pon0-registration";
		};
	};
};
