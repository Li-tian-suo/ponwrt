+/*
+ * EN8811H MMD access.
+ *
+ * Neither core path works on this chip: with is_c45 == 0 the composite
+ * address is handed straight to bus->read()/bus->write() and mdio-airoha
+ * packs it into the five bit AN7583_MII_CL22_REG_ADDR field (BUSY never
+ * clears, -ETIMEDOUT); with is_c45 == 1 the controller sends real C45
+ * frames that the PHY does not answer.
+ *
+ * Walk 0x0d/0x0e by hand like the vendor module does. On this board the
+ * standard page answers first, so probe it before the extended page 4.
+ */
+#define AIR_MMD_CTRL_REG	0x0d
+#define AIR_MMD_DATA_REG	0x0e
+#define AIR_MMD_ADDR_MODE	0x4000
+
+static int __air_mmd_read_on_page(struct phy_device *phydev, int page,
+				  int devad, u16 regnum)
+{
+	int ret;
+
+	ret = __phy_write(phydev, AIR_EXT_PAGE_ACCESS, page);
+	if (ret < 0)
+		return ret;
+	ret = __phy_write(phydev, AIR_MMD_CTRL_REG, devad);
+	if (ret < 0)
+		goto out;
+	ret = __phy_write(phydev, AIR_MMD_DATA_REG, regnum);
+	if (ret < 0)
+		goto out;
+	ret = __phy_write(phydev, AIR_MMD_CTRL_REG, AIR_MMD_ADDR_MODE | devad);
+	if (ret < 0)
+		goto out;
+
+	ret = __phy_read(phydev, AIR_MMD_DATA_REG);
+
+out:
+	__phy_write(phydev, AIR_EXT_PAGE_ACCESS, AIR_PHY_PAGE_STANDARD);
+	return ret;
+}
+
+static int air_mmd_read(struct phy_device *phydev, int devad, u16 regnum)
+{
+	int ret;
+
+	ret = __air_mmd_read_on_page(phydev, AIR_PHY_PAGE_STANDARD, devad, regnum);
+	if (ret >= 0)
+		return ret;
+
+	return __air_mmd_read_on_page(phydev, AIR_PHY_PAGE_EXTENDED_4, devad, regnum);
+}
+
+static int en8811h_read_mmd(struct phy_device *phydev, int devad, u16 regnum)
+{
+	return air_mmd_read(phydev, devad, regnum);
+}
+
+static int en8811h_write_mmd(struct phy_device *phydev, int devad, u16 regnum,
+			     u16 val)
+{
+	int ret, page;
+
+	for (page = AIR_PHY_PAGE_STANDARD; ; page = AIR_PHY_PAGE_EXTENDED_4) {
+		ret = __phy_write(phydev, AIR_EXT_PAGE_ACCESS, page);
+		if (ret < 0)
+			return ret;
+		ret = __phy_write(phydev, AIR_MMD_CTRL_REG, devad);
+		if (ret < 0)
+			goto next;
+		ret = __phy_write(phydev, AIR_MMD_DATA_REG, regnum);
+		if (ret < 0)
+			goto next;
+		ret = __phy_write(phydev, AIR_MMD_CTRL_REG,
+				  AIR_MMD_ADDR_MODE | devad);
+		if (ret < 0)
+			goto next;
+		ret = __phy_write(phydev, AIR_MMD_DATA_REG, val);
+
+next:
+		__phy_write(phydev, AIR_EXT_PAGE_ACCESS, AIR_PHY_PAGE_STANDARD);
+		if (ret >= 0 || page == AIR_PHY_PAGE_EXTENDED_4)
+			return ret;
+	}
+}
